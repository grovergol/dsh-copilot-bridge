{
  "name": "dsh-copilot-bridge",
  "version": "0.1.0",
  "description": "Use your VS Code Copilot agents and skills (.github and ~/.copilot) directly in DeepSeek Harness.",
  "license": "MIT",
  "icon": "./icon.svg",
  "type": "module",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grovergol/dsh-copilot-bridge.git"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
